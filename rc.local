# Put your custom commands here that should be executed once
# the system init finished. By default this file does nothing.

# =====================================================================
# Hetzner DynDNS for Teltonika RutOS / OpenWrt - new Cloud API
# (api.hetzner.cloud, replaces the retired dns.hetzner.com API)
#
# Set your values below BEFORE the first boot. They seed
# /root/dyndns.conf exactly once - afterwards edit that file directly.
# The script itself is downloaded from GitHub on every boot
# (the local copy is kept when the download fails).
# =====================================================================

# ------------- configuration (only used to seed the conf) ------------
# Hetzner Cloud API token with read & write permissions
HETZNER_TOKEN='YOUR_HETZNER_CLOUD_API_TOKEN'
ZONE_NAME='YOUR.DOMAIN'
RECORD_NAME='YOUR_RECORD_NAME'
RECORD_TTL='300'
# ---------------------------------------------------------------------

REPO_RAW='https://raw.githubusercontent.com/f-io/RUTX-DYNDNS-HETZNER/main'

# seed the config once - edit /root/dyndns.conf to change it later
if [ ! -f /root/dyndns.conf ]; then
cat > /root/dyndns.conf << EOF
HETZNER_TOKEN='${HETZNER_TOKEN}'
ZONE_NAME='${ZONE_NAME}'
RECORD_NAME='${RECORD_NAME}'
RECORD_TTL='${RECORD_TTL}'
EOF
chmod 600 /root/dyndns.conf
fi

# download helper - keeps the old copy if the download fails
fetch() {
  curl -fsSL --connect-timeout 5 -o "/tmp/${1}.new" "${REPO_RAW}/${1}" \
    && head -n1 "/tmp/${1}.new" | grep -q '^#!/bin/sh' \
    && mv "/tmp/${1}.new" "/root/${1}" \
    && chmod a+x "/root/${1}"
}

# wait for the WAN to come up if there is no local copy yet
if [ ! -f /root/dyndns.sh ]; then
  i=0
  while [ $i -lt 12 ]; do
    fetch dyndns.sh && break
    i=$((i+1))
    sleep 5
  done
else
  fetch dyndns.sh
fi

# cron: a single auto-mode entry updates A and/or AAAA - whatever the
# uplink currently provides; stale -T entries from older setups are removed
CRONTAB=/etc/crontabs/root
touch "$CRONTAB"
sed -i '/dyndns\.sh -T/d' "$CRONTAB"
grep -q '/root/dyndns.sh' "$CRONTAB" || \
  echo '*/2 * * * * /root/dyndns.sh >/dev/null 2>&1' >> "$CRONTAB"
/etc/init.d/cron restart

# update the records once right after boot
[ -x /root/dyndns.sh ] && /root/dyndns.sh >/dev/null 2>&1 &

exit 0
